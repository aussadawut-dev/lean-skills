  "review": {
    "status": "REWORK",
    "findings": [
      {
        "id": "F1",
        "severity": "HIGH",
        "location": "vault.py:118-130",
        "requirement": "Preserve existing rows, including unrelated tenants' audit history, when committing a transfer.",
        "evidence": "Seed accounts ('one','a',100), ('one','b',0), ('two','a',100), ('two','b',0). Execute transfer(path,'two','a','b',7,'past'). Create UNIQUE INDEX audit_identity ON audit(tenant,key), then CREATE TRIGGER fault AFTER INSERT ON audit WHEN NEW.tenant='one' BEGIN INSERT OR REPLACE INTO audit VALUES('two','past','temporary','b',1); DELETE FROM audit WHERE tenant='two' AND key='past' AND source='temporary'; END. Calling transfer(path,'one','a','b',10,'new') succeeds but permanently deletes tenant two's historical audit row. The observer tracks only rowid collisions for audit, so it misses the unique-index replacement victim. Reproduced through the CLI in DELETE and WAL modes: exit 0, normal receipt, empty stderr, and missing history after reopening. Replaying the historical transfer does not restore its audit row.",
        "suggested_fix": "Track replacement victims for every applicable unique constraint or index before validating the transaction. Preserve valid ignored conflicts and harmless replacements. Add a regression pairing this destructive REPLACE case with the successful OR IGNORE control."
      }
    ],
    "checks": [
      "Read lean-run, write-integrity guidance, CONTRACT.md and AGENTS.md; compared baseline and current application files and inspected added tests.",
      "python3 -B -m unittest discover -v: all 24 tests passed.",
      "Independent replacement probe demonstrated durable audit-history loss; paired OR IGNORE control preserved history.",
      "CLI reproduction confirmed the defect in both DELETE and WAL journal modes.",
      "Independent probes passed for malformed unrelated SQLite text with benign triggers, embedded-NUL identifiers, and generic rejection of surrogate and oversized-amount inputs.",
      "No application, test, instruction or baseline files modified; probes used temporary workspace paths."
    ],
    "coverage_limits": [
      "The demonstrated defect requires an additional UNIQUE index on audit(tenant,key) and a replacement trigger; that index is absent from the default schema.",
      "Checks used Python 3.14.3 and SQLite 3.50.4. Process termination, power loss and disk exhaustion were not simulated."
    ]
  },
